{
  "name": "express-swagger-docauto",
  "version": "0.4.0",
  "description": "Project-wide source analysis to generate OpenAPI for Express without handwritten schemas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/internal/cli.js"
  },
  "bin": {
    "swaggerdoc-auto": "./dist/internal/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "swagger-ui-express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "swagger-ui-express": {
      "optional": true
    }
  },
  "license": "MIT"
}
